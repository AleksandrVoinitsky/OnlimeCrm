# Django environment. Use "production" on Amvera.
DJANGO_ENV=development
DEBUG=True
SECRET_KEY=replace-with-a-unique-secret-key-before-production
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# This path must be inside Amvera persistent storage in production.
DATABASE_PATH=/data/db.sqlite3
MEDIA_ROOT=/data/media
STATIC_ROOT=/app/staticfiles

# HTTPS settings. Enable only when HTTPS terminates at the hosting proxy.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# Local compose port.
WEB_PORT=8000
