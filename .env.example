# Django environment. Use "production" on DockerHosting.ru.
DJANGO_ENV=development
DEBUG=True
SECRET_KEY=replace-with-a-unique-secret-key-before-production
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# This path must be inside the mounted persistent volume in production.
DATABASE_PATH=/var/lib/onlime/db.sqlite3

# HTTPS settings. Enable only when HTTPS terminates at the hosting proxy.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# Local compose port.
WEB_PORT=8000
